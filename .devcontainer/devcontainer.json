{
  "name": "Visual Inspection SuperSimpleNet",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },
  "mounts": [
    "source=${localWorkspaceFolderBasename}-venv,target=${containerWorkspaceFolder}/.venv,type=volume",
    "source=${localWorkspaceFolderBasename}-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=${localWorkspaceFolderBasename}-uv-cache,target=/home/vscode/.cache/uv,type=volume",
    "source=${localWorkspaceFolderBasename}-npm-cache,target=/home/vscode/.npm,type=volume"
  ],
  "postCreateCommand": "sudo git config --system --add safe.directory \"$PWD\" && sudo chown -R vscode:vscode .venv node_modules /home/vscode/.cache/uv /home/vscode/.npm && uv sync --locked && npm ci"
}
